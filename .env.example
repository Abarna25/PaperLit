# =============================================================================
# LitTrust AI — Environment Configuration Template
# Copy this file to .env and provide your deployment credentials.
# =============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Supabase Credentials (Database, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=littrust-artifacts

# Academic & Scholarly API Integrations
# arXiv requires polite queries; no key required
# Semantic Scholar API Key (Optional for basic tier, recommended for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref Polite Pool Mailto Header (Required by Crossref terms of service)
CROSSREF_MAILTO=researcher@littrust.ai

# Optional LLM Integration (OpenAI or Gemini)
# Deterministic core operates completely without an LLM key
LLM_API_KEY=
LLM_PROVIDER=none

# Networking & Service Hosts
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://*.vercel.app"]

# Limits & Quotas
MAX_PDF_SIZE_BYTES=31457280
HTTP_TIMEOUT_SECONDS=20.0
MAX_PAPERS_PER_QUERY=25
MOCK_MODE=false
